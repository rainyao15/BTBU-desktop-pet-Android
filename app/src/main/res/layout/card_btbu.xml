<?xml version="1.0" encoding="utf-8"?>
<!-- 北工商数据卡：账号 + 同步。由 activity_main.xml 用 <include> 引进来 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="北工商 · 账号与同步"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="走掌上北工商同一套接口：课表 / 校园网网费 / 校园卡余额"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/accUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_ghost"
        android:hint="学号"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/accPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_ghost"
        android:hint="密码（只存在本机）"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBtbuLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="登录并同步"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnBtbuHud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="桌面小卡"
            android:textColor="@color/text_sub"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnBtbuSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_ghost"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="看整周课表"
        android:textColor="@color/text_sub"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/accStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="还没同步过"
        android:textColor="@color/text_sub"
        android:textSize="11sp" />
</LinearLayout>
